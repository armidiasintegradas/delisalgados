# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production database authority
# Keep false/absent in production. Local fallback is development/test only.
DELI_ALLOW_LOCAL_DB=false

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Uber Direct — optional realtime delivery quote integration
# Create/approve the account in Uber Direct before filling these values.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
